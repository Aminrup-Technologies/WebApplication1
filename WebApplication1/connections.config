<?xml version="1.0" encoding="utf-8"?>
<!--
  PLACEHOLDER - commit-safe copy, NO REAL CREDENTIALS HERE.
  This file is referenced from Web.config via <connectionStrings configSource="connections.config" />,
  so it MUST exist for the app to boot (this placeholder guarantees that on fresh clones).
  It is excluded from IIS publish (see ExcludeFilesFromDeployment in WebApplication1.csproj),
  so deploying the app will NOT overwrite the real connections.config already on the server.
  On the server, replace the DbConn value with the real connection string, e.g.:
  <add name="DbConn" connectionString="Data Source=...;Initial Catalog=ats_erp;User ID=...;Password=...;" providerName="System.Data.SqlClient" />
-->
<connectionStrings>
  <add name="DbConn" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ats_erp;Integrated Security=True;Max Pool Size=100" providerName="System.Data.SqlClient" />
</connectionStrings>
